# =============================================================
# Frontend (Next.js) — plantilla de variables de entorno.
# Copia este archivo como `.env.local` (gitignored) y rellena.
# El backend tiene su propia plantilla en server/.env.example.
# =============================================================

# --- API propia (backend Express) ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Sitio público (SEO / metadata / sitemap) ---
# Dominio canónico de producción. En dev local se puede dejar vacío
# y el código cae al fallback.
NEXT_PUBLIC_SITE_URL=

# =============================================================
# Sentry (monitoreo de errores)
# Sin DSN, Sentry no se inicializa y la app sigue funcionando.
# =============================================================
# Sentry → Project Settings → Client Keys (DSN). El mismo valor en las dos.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Para subir source maps en el build de Vercel (opcional).
# Sentry → Settings → Auth Tokens.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# =============================================================
# Cron de recordatorios de citas
# =============================================================
# Protege /api/reminders/send. DEBE coincidir con el CRON_SECRET del backend.
# Vercel Cron inyecta el header Authorization automáticamente si está seteada.
# Generar: openssl rand -hex 32
CRON_SECRET=
