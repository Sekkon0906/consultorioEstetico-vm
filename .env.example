# =============================================================
# Plantilla de variables de entorno
# Copia este archivo como `.env.local` (gitignored) y rellena
# con los valores reales. NUNCA commitear `.env.local`.
# =============================================================

# --- Supabase (requeridas) ---
# Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Dashboard → Project Settings → API → anon / public key
# IMPORTANTE: solo la ANON key va al frontend.
# La service_role key JAMÁS debe estar en variables NEXT_PUBLIC_*
# (solo en entornos server-only si la usas en API routes).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Sitio público (SEO / metadata / sitemap) ---
# Dominio canónico de producción. En dev local podés dejarlo
# en blanco y el código cae al fallback.
NEXT_PUBLIC_SITE_URL=https://clinicavanessamedina.com

# --- API legacy (opcional, queda por compatibilidad) ---
# Si no usas backend Express puedes dejar vacío o eliminar.
NEXT_PUBLIC_API_URL=

# =============================================================
# Variables server-only (NO usar prefijo NEXT_PUBLIC_)
# Estas solo se inyectan en server actions / route handlers.
# =============================================================

# Service role — solo se usa en API routes server-side (route handlers
# que requieren bypass de RLS, como el cron de recordatorios).
SUPABASE_SERVICE_ROLE_KEY=

# Secreto que protege el endpoint POST/GET /api/reminders/send.
# Generar con: openssl rand -hex 32
# Vercel Cron inyecta este header automáticamente cuando setteas la env.
CRON_SECRET=

# Resend (https://resend.com) — envío de recordatorios y notificaciones.
RESEND_API_KEY=
# Remitente verificado en tu cuenta Resend. Ej: "Consultorio JM <citas@clinicavm.com>"
RESEND_FROM=
# Correo de la doctora: recibe el aviso cuando alguien agenda una cita nueva.
NOTIFY_DOCTOR_EMAIL=julieth.medina9628@gmail.com

# =============================================================
# Sentry (monitoreo de errores)
# Si dejas el DSN vacío, Sentry no se inicializa y la app sigue
# funcionando normal — útil para entornos de dev sin reportes.
# =============================================================
# Dashboard Sentry → Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=

# Para subir source maps en builds productivos (CI / Vercel)
# Sentry → Settings → Auth Tokens (scope: project:write)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
