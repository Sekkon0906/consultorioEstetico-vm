# Base de datos
DATABASE_URL=postgres://usuario:clave@localhost:5432/consultorio

# CORS y servidor
CORS_ORIGIN=http://localhost:3000
PORT=4000
NODE_ENV=development

# Copiloto de IA (opcional).
# Sin ANTHROPIC_API_KEY el servidor arranca igual: la sección Asistente del
# panel responde 503 con un mensaje claro en vez de romperse.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Requerida SOLO si quieres que la doctora pueda pegar su propia clave desde
# el panel (Asistente → "Sin configurar"), en vez de depender de
# ANTHROPIC_API_KEY de aquí arriba. Es la contraseña con la que se cifra esa
# clave antes de guardarla en la base (pgcrypto) -- nunca en texto plano.
# Genera una larga y aleatoria, ej: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# --- Durante la migración: todavía en uso hasta completar la fase 03 ---
SUPABASE_URL=https://ibpkihfjripvizismhsk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
