# ============================================================================
# Variables del backend. Copia este archivo a .env y rellena lo que uses.
# Todo lo marcado OPCIONAL puede quedar vacío: el servidor arranca igual y la
# función correspondiente responde con un mensaje claro en vez de romperse.
# ============================================================================

# ── Base de datos (obligatoria) ─────────────────────────────────────────────
DATABASE_URL=postgres://usuario:clave@localhost:5432/consultorio

# ── Servidor ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Orígenes permitidos, separados por coma. Debe incluir el dominio del sitio.
CORS_ORIGIN=http://localhost:3000
# URL pública del sitio (para los enlaces de los correos y los redirects).
APP_URL=http://localhost:3000
# URL pública de esta API (para el callback de Google).
API_URL=http://localhost:4000

# ── Autenticación propia ────────────────────────────────────────────────────
# Firma los tokens de sesión. Genera una con: openssl rand -base64 48
# Cambiarla cierra todas las sesiones abiertas.
JWT_SECRET=

# Inicio de sesión con Google. Se crean en Google Cloud Console →
# APIs y servicios → Credenciales → ID de cliente de OAuth (aplicación web).
# En "URI de redireccionamiento autorizados" hay que poner EXACTAMENTE:
#   <API_URL>/auth2/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Correo (Resend) ─────────────────────────────────────────────────────────
# OPCIONAL. Sin esto no se envían correos (verificación, recuperación, avisos
# de citas, recordatorios); quedan registrados en consola. resend.com/api-keys
RESEND_API_KEY=
# Remitente. El dominio debe estar verificado en Resend con SPF y DKIM, o los
# correos caen en spam. Antes de tener dominio, sirve onboarding@resend.dev.
CORREO_DESDE="Dra. Vanessa Medina <no-responder@tudominio.com>"
# Correo de la doctora: recibe el aviso cuando alguien agenda una cita nueva.
NOTIFY_DOCTOR_EMAIL=

# Protege POST /citas/recordatorios (el cron de recordatorios 24 h antes).
# Debe coincidir con el CRON_SECRET del frontend (Vercel). openssl rand -hex 32
CRON_SECRET=

# ── Almacenamiento de archivos (Cloudflare R2) ──────────────────────────────
# OPCIONAL mientras las imágenes sigan en Supabase Storage.
# Se crean en el panel de Cloudflare → R2 → Manage API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL pública del bucket. Conviene un subdominio propio (ej: archivos.tudominio.com)
# y no la URL de r2.dev: si se cambia de proveedor, no hay que reescribir cada fila.
R2_PUBLIC_URL=

# ── Copiloto de IA ──────────────────────────────────────────────────────────
# OPCIONAL. Sin clave, la sección Asistente del panel responde 503 con un
# mensaje claro en vez de romperse.
ANTHROPIC_API_KEY=
# Opus 5 es el más capaz pero el más caro. Para el copiloto (crear
# procedimientos, promociones, consultar citas) claude-haiku-4-5 sobra y
# cuesta una fracción.
ANTHROPIC_MODEL=claude-haiku-4-5

# Requerida SOLO para que la doctora pueda guardar su propia clave desde el
# panel. Es con lo que se cifra antes de guardarla (pgcrypto), nunca en texto
# plano. Genera una con: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# ── Supabase (en retirada) ──────────────────────────────────────────────────
# Mientras el frontend siga usando Supabase Auth y Storage. Cuando la
# migración termine, estas dos se borran y el backend sigue funcionando: ya
# no se exige ninguna al arrancar.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
